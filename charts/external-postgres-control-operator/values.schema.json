{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "name"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "requests": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "metricsIngressPeers",
        "egress"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "metricsIngressPeers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/networkPolicyPeer"
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "rules"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "to": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/definitions/networkPolicyPeer"
                    }
                  },
                  "ports": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/definitions/networkPolicyPort"
                    }
                  }
                }
              }
            }
          },
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "rules": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft-07/schema#",
  "definitions": {
    "cidr": {
      "type": "string",
      "anyOf": [
        {
          "pattern": "^(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/(?:3[0-2]|[12]?[0-9])$"
        },
        {
          "pattern": "^(?:[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4}){7}|::(?:[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4}){0,6})?|[0-9A-Fa-f]{1,4}::(?:[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4}){0,5})?|[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}::(?:[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4}){0,4})?|[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}::(?:[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4}){0,3})?|[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}::(?:[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4}){0,2})?|[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}::(?:[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4}){0,1})?|[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}::(?:[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4}){0,0})?|[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}::|(?:[0-9A-Fa-f]{1,4}:){6}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|::(?:[0-9A-Fa-f]{1,4}:){0,5}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|[0-9A-Fa-f]{1,4}::(?:[0-9A-Fa-f]{1,4}:){0,4}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}::(?:[0-9A-Fa-f]{1,4}:){0,3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}::(?:[0-9A-Fa-f]{1,4}:){0,2}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}::(?:[0-9A-Fa-f]{1,4}:){0,1}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}::(?:[0-9A-Fa-f]{1,4}:){0,0}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3})/(?:12[0-8]|1[01][0-9]|[1-9]?[0-9])$"
        }
      ]
    },
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "matchExpressions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "operator"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "enum": [
                  "In",
                  "NotIn",
                  "Exists",
                  "DoesNotExist"
                ]
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "operator": {
                      "enum": [
                        "In",
                        "NotIn"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "values"
                  ],
                  "properties": {
                    "values": {
                      "minItems": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "operator": {
                      "enum": [
                        "Exists",
                        "DoesNotExist"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "values": {
                      "maxItems": 0
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "networkPolicyPeer": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "podSelector": {
          "$ref": "#/definitions/labelSelector"
        },
        "namespaceSelector": {
          "$ref": "#/definitions/labelSelector"
        },
        "ipBlock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cidr"
          ],
          "properties": {
            "cidr": {
              "$ref": "#/definitions/cidr"
            },
            "except": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/cidr"
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "ipBlock"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "podSelector"
                ]
              },
              {
                "required": [
                  "namespaceSelector"
                ]
              }
            ]
          }
        },
        {
          "anyOf": [
            {
              "required": [
                "podSelector"
              ]
            },
            {
              "required": [
                "namespaceSelector"
              ]
            }
          ],
          "not": {
            "required": [
              "ipBlock"
            ]
          }
        }
      ]
    },
    "networkPolicyPort": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "port": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 15,
              "allOf": [
                {
                  "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
                },
                {
                  "pattern": "[a-z]"
                }
              ]
            }
          ]
        },
        "protocol": {
          "enum": [
            "TCP",
            "UDP",
            "SCTP"
          ]
        },
        "endPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "if": {
        "required": [
          "endPort"
        ]
      },
      "then": {
        "required": [
          "port"
        ],
        "properties": {
          "port": {
            "type": "integer"
          }
        }
      }
    }
  }
}
